# =============================================================================
# ACTIVE PROFILE — local `uv run` (AuraDB Free OR Docker Neo4j)
# =============================================================================
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=xxxxxxxx
NEO4J_USER=xxxxxxxx
NEO4J_PASSWORD=your_aura_password
NEO4J_DATABASE=xxxxxxxx

TMDB_API_KEY=your_tmdb_api_key

# Published QA eval used qwen3:8b. llama3.2:3b often writes invalid Cypher.
OLLAMA_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TEMPERATURE=0
GRAPH_RAG_TOP_K=25

# =============================================================================
# DOCKER COMPOSE ONLY — separate from Aura (safe to keep both in one file)
# docker-compose.yml reads DOCKER_* so it never overwrites your Aura login.
# =============================================================================
DOCKER_NEO4J_USER=neo4j
DOCKER_NEO4J_PASSWORD=password
DOCKER_NEO4J_DATABASE=neo4j
# Smaller default for Compose RAM. Pull qwen3:8b to match the published GraphRAG eval.
DOCKER_OLLAMA_MODEL=llama3.2:3b

NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
STREAMLIT_PORT=8501
OLLAMA_PORT=11434
